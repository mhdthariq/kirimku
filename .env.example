# =============================================================================
# Shipment & Logistics Management System — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust:
#     cp .env.example .env
#
# The app reads exactly ONE variable: DATABASE_URL (consumed by Prisma).
# No API keys or secrets are required to run the whole system locally.
# =============================================================================

# -----------------------------------------------------------------------------
# OPTION 1 — SQLite (default: zero-config local development)
# -----------------------------------------------------------------------------
# Path is resolved relative to the prisma/ folder, so "file:../db/custom.db"
# maps to <project-root>/db/custom.db. The file is created automatically by:
#     bun run db:push
DATABASE_URL="file:../db/custom.db"

# -----------------------------------------------------------------------------
# OPTION 2 — Supabase Postgres (or any PostgreSQL server)
# -----------------------------------------------------------------------------
# Get the values from: Supabase Dashboard → Project Settings → Database
# (placeholders below: [PROJECT-REF], [REGION], [YOUR-PASSWORD]).
#
# STEP 1  Switch the Prisma provider (one line) in prisma/schema.prisma:
#             datasource db {
#               provider = "postgresql"   // was "sqlite"
#               url      = env("DATABASE_URL")
#             }
# STEP 2  In .env, comment out the SQLite line above and uncomment ONE of
#         the connection strings below.
# STEP 3  Recreate schema + demo data:
#             bun run db:push && bun run db:seed
#
# The schema uses only String/Int/Float/Boolean/DateTime types (no SQLite-only
# features), so it is 100% PostgreSQL-compatible as-is.
#
# (a) DIRECT connection (port 5432) — for `prisma db push` / migrations.
#     Requires IPv6 support on your network; if push times out, use (b).
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
#
# (b) SESSION pooler (port 5432, username includes the project ref) —
#     IPv4-friendly. Works for BOTH the CLI (db push) and long-running app
#     servers (bun run dev / bun run start).
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
#
# (c) TRANSACTION pooler (port 6543) — for serverless/short-lived connections
#     (Vercel, Edge, lambdas). NOT valid for prisma db push / migrate — use it
#     only as the RUNTIME url on your hosting platform.
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#
# RECOMMENDED SETUP:
#   • .env (local / CLI)        → use (b) session pooler for db:push + dev
#   • hosting platform runtime  → use (c) transaction pooler for production
#
# TIP — If you prefer Prisma's official two-URL setup for Supabase, add this
# line to the datasource block in prisma/schema.prisma:
#             directUrl = env("DIRECT_URL")
# then set DATABASE_URL to a pooler URL (b)/(c) and DIRECT_URL to (a).
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# (Nothing else required. Auth sessions are stored in the DB; the web app
#  does not depend on any third-party service to run.)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# OPTIONAL — Company name printed on the resi (Shipment Resi & Detail Resi)
# -----------------------------------------------------------------------------
# Default when unset: "KirimKu Logistics"
# Ignored for anyone logging in with a Corporate ID — that name comes from
# the license server's NamaCustomer field instead (see below). This value is
# only used in "default tenant" mode (no Corporate ID entered at login).
# NEXT_PUBLIC_COMPANY_NAME="PT KirimKu Logistik Indonesia"

# -----------------------------------------------------------------------------
# OPTIONAL — Multi-tenant Corporate ID login (Nova Logistik license server)
# -----------------------------------------------------------------------------
# When a user enters a Corporate ID at login, the app calls the license
# server below to (1) validate the license and (2) get the PostgreSQL
# connection details for that company's own database, and connects to it
# dynamically for the rest of that session — DATABASE_URL above is only
# used when NO Corporate ID is supplied (local/demo mode).
#
# DEV vs PROD behavior:
#   • `bun run dev` (NODE_ENV=development) — the Corporate ID field on the
#     login screen is HIDDEN and the license server is NEVER contacted.
#     The app always talks to DATABASE_URL above, which is exactly what
#     you want when iterating on the schema with `prisma db push`.
#   • `bun run build` + `bun run start` (NODE_ENV=production) — the
#     Corporate ID field is shown, the license server is contacted on
#     every request, and each tenant is routed to its own database.
#
# All of these have working defaults baked in for the Nova Logistik portal;
# only set them here if you need to override the endpoint/credentials/app
# name used in the KdCustomer/Aplikasi lookup. They are ignored in dev mode.
# LICENSE_API_URL="Link API for license check"
# LICENSE_API_KEY="API key for license"
# LICENSE_API_TOKEN="API token for license"
# LICENSE_APLIKASI="Application Name"

